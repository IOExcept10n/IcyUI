<!-- The README cover (docs/images/cover.png): a showcase scene rendered by IcyUI.Docs.Capture, not a mock-up. Data context: DocsSnippetViewModel. -->
<Border Width="1200" Height="560" Background="#FF14141A" Padding="56,48">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="640" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
      <TextBlock FontSize="88" Foreground="#FFEAF4FF">IcyUI</TextBlock>
      <TextBlock FontSize="26" Foreground="#FF8FB8E8" Margin="4,8,0,0">Cross-engine UI for .NET games</TextBlock>
      <TextBlock FontSize="18" Foreground="#FF6C7A8C" Margin="4,28,0,0">Markup · Binding · Themes · Gamepad and touch</TextBlock>
      <TextBlock FontSize="18" Foreground="#FF6C7A8C" Margin="4,6,0,0">Stride · MonoGame</TextBlock>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
      <TabControl ItemsSource="{Binding Tabs}" SelectedIndex="1" Height="130" Margin="0,0,0,16" />
      <StackPanel Orientation="Horizontal">
        <ColorPicker SelectedColor="#FF3C78D8" Width="300" Height="240" Margin="0,0,20,0" />
        <StackPanel Orientation="Vertical" Width="300">
          <TextBlock Margin="0,0,0,4">Volume</TextBlock>
          <Slider Minimum="0" Maximum="100" Value="70" Margin="0,0,0,16" />
          <TextBlock Margin="0,0,0,4">Loading</TextBlock>
          <ProgressBar Minimum="0" Maximum="100" Value="64" Height="8" Margin="0,0,0,16" />
          <ComboBox ItemsSource="{Binding Levels}" SelectedIndex="1" Margin="0,0,0,16" />
          <CheckBox IsChecked="True" Margin="0,0,0,8">Subtitles</CheckBox>
          <Button Padding="24,8">Play</Button>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
</Border>
